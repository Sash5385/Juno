{
  "functions": {
    "source": "functions"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "admin",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Content-Security-Policy",
              "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/liqpay-order",
          "function": "createLiqPayOrder",
          "region": "europe-west1"
        },
        {
          "source": "/api/monobank-invoice",
          "function": "createMonobankInvoice",
          "region": "europe-west1"
        },
        {
          "source": "/api/delete-account",
          "function": "deleteAccount",
          "region": "europe-west1"
        },
        {
          "source": "/api/report-error",
          "function": "reportError",
          "region": "europe-west1"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "landing",
      "public": "landing",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/img/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Content-Security-Policy",
              "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/juno",
          "destination": "/index-new.html"
        },
        {
          "source": "/api/contact",
          "function": "submitContact",
          "region": "europe-west1"
        }
      ],
      "redirects": [
        {
          "source": "/juno/",
          "destination": "/juno",
          "type": 301
        }
      ]
    }
  ]
}
