rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /instructors/{iid}/profile.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == iid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
