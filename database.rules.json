{
  "rules": {
    // Салон = група окремих майстрів зі спільною публічною сторінкою /s/{slug}.
    // salons/{slug}: { ownerIid, name, createdAt, masters: { iid: 'owner' | токен запрошення } }.
    // Створює й змінює салон лише власник; майстер сам приєднується (лише з чинним запрошенням) і сам виходить.
    "salons": {
      "$slug": {
        ".read": true,
        ".write": "auth != null && $slug.matches(/^[a-z0-9-]{3,40}$/) && ((!data.exists() && newData.child('ownerIid').val() === auth.uid) || (data.exists() && data.child('ownerIid').val() === auth.uid && (!newData.exists() || newData.child('ownerIid').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['ownerIid','name']) && newData.child('name').isString() && newData.child('name').val().length <= 60",
        "masters": {
          "$mid": {
            ".write": "auth != null && auth.uid === $mid && (!newData.exists() || (newData.isString() && root.child('salon_invites/'+newData.val()+'/salon').val() === $slug && root.child('salon_invites/'+newData.val()+'/expiresAt').val() > now))"
          }
        }
      }
    },
    // Запрошення майстра в салон-простір: читається за токеном (список недоступний); створює й видаляє лише власник простору (iid === auth.uid),
    // лише для акаунта-салону, діє до 14 днів.
    "workspace_invites": {
      "$token": {
        ".read": true,
        ".write": "auth != null && (newData.exists() ? newData.child('iid').val() === auth.uid : data.child('iid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['iid','expiresAt']) && newData.child('iid').isString() && newData.child('expiresAt').isNumber() && newData.child('expiresAt').val() <= now + 1209600000 && root.child('instructors/'+newData.child('iid').val()+'/admin_settings/accountType').val() === 'salon'"
      }
    },
    // Куди пускати майстра салону при вході: staff_index/{uid} = { iid }. Пише лише сам майстер, і лише коли його рядок у складі вже є
    // (role master); видалити може він сам або власник простору.
    "staff_index": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || root.child('instructors/'+newData.child('iid').val()+'/staff/'+$uid+'/role').val() === 'master')) || (!newData.exists() && data.child('iid').val() === auth.uid))",
        ".validate": "newData.hasChild('iid') && newData.child('iid').isString()"
      }
    },
    // Запрошення майстра в салон: читається за токеном (список недоступний), пишуть лише власник салону
    "salon_invites": {
      "$token": {
        ".read": true,
        ".write": "auth != null && (newData.exists() ? (root.child('salons/'+newData.child('salon').val()+'/ownerIid').val() === auth.uid && newData.child('ownerIid').val() === auth.uid) : data.child('ownerIid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['salon','ownerIid','expiresAt']) && newData.child('expiresAt').isNumber() && newData.child('expiresAt').val() <= now + 1209600000"
      }
    },
    "slugs": {
      ".read": true,
      "$slug": {
        ".write": "auth != null && (data.exists() ? data.child('iid').val() === auth.uid : newData.child('iid').val() === auth.uid)"
      }
    },
    "instructors": {
      "$iid": {
        ".read": "auth != null && auth.uid === $iid",
        // Майстер пише в свій вузол, але НЕ може видалити license чи її ключові поля
        // (status/expiresAt/trialEndsAt): без них клієнт вважає ліцензію відсутньою, тобто доступ вільним,
        // а видалення + повторне створення дало б новий пробний період. Змінювати ліцензію може власник
        // (license/.write нижче) і Cloud Functions (admin SDK обходить правила).
        ".write": "auth != null && auth.uid === $iid && (!data.child('license/status').exists() || newData.child('license/status').exists()) && (!data.child('license/expiresAt').exists() || newData.child('license/expiresAt').exists()) && (!data.child('license/trialEndsAt').exists() || newData.child('license/trialEndsAt').exists())",

        "admin_settings": {
          ".read": true,
          // Тип акаунта: «Один майстер» (solo) або «Салон» (salon) — один акаунт із кількома майстрами всередині
          "accountType": { ".validate": "newData.val() === 'solo' || newData.val() === 'salon'" }
        },
        // Склад робочого простору (салон): { uid: { role: 'owner' | 'master', name, color, joinedAt } }.
        // Власник (uid === iid) — завжди роль owner; майстри — лише master. Читає власник і сам склад; пише лише власник.
        // Публічний список майстрів салону (для сторінки запису клієнта): { masterId: { name, color, owner } } — синхронізує застосунок власника зі складом
        "masters": { ".read": true },
        "staff": {
          ".read": "auth != null && (auth.uid === $iid || data.child(auth.uid).exists())",
          "$mid": {
            // Майстер сам вписує СЕБЕ за чинним запрошенням (inviteToken) лише з роллю master і може лише вийти (видалити свій рядок).
            ".write": "auth != null && auth.uid === $mid && $mid !== $iid && (!newData.exists() || (!data.exists() && newData.child('role').val() === 'master' && newData.child('inviteToken').isString() && root.child('workspace_invites/'+newData.child('inviteToken').val()+'/iid').val() === $iid && root.child('workspace_invites/'+newData.child('inviteToken').val()+'/expiresAt').val() > now))",
            ".validate": "newData.hasChildren(['role','name']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 60 && (($mid === $iid && newData.child('role').val() === 'owner') || ($mid !== $iid && newData.child('role').val() === 'master')) && (!newData.child('color').exists() || (newData.child('color').isString() && newData.child('color').val().matches(/^#[0-9a-fA-F]{6}$/)))"
          }
        },
        "admin_data": {
          "services": { ".read": true }
        },
        // Слоти інших майстрів салону: timeslots_m/{masterId}/{date}/{slotId}. Читає хто завгодно (як timeslots); пише власник
        // (клієнтські правила запису в них — на етапі «клієнтський бік»).
        "timeslots_m": {
          ".read": true,
          // Слоти майстра салону: як timeslots — майстер салону (staff) і власник пишуть усе, клієнт цього простору лише бронює/звільняє СВОЇ слоти (ті самі обмеження)
          "$mid": {
            ".write": "auth != null && auth.uid === $mid && root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master'",
            "$date": {
            "$slotId": {
              // Майстер — усе. Клієнт лише свого майстра (є users/{uid}):
              //  • адмінські поля слота (adminBlocked/vipOnly/privateOnly/surcharge/fixedPrice/lunchOverride/durMin/personal) незмінні й не видаляються;
              //  • новий слот — лише як зайнятий (phantom); видалити можна тільки власний phantom (bookedBy);
              //  • ЗАЙНЯТИЙ слот чіпає лише той, хто його зайняв (bookedBy === uid): чужий слот не звільнити і не перезаписати;
              //  • bookedBy можна виставити лише собі; слот, зарезервований для іншого (reservedFor) до reservedUntil, не зайняти.
              // Звільнення слотів при скасуванні і так робить сервер (onBookingChanged, admin SDK).
              ".write": "auth != null && ((auth.uid === $iid || (auth.uid === $mid && root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master')) || (root.child('instructors/'+$iid+'/users/'+auth.uid).exists() && (data.exists() || newData.child('available').val() === false) && (newData.exists() || (data.child('phantom').val() === true && data.child('bookedBy').val() === auth.uid)) && (data.child('available').val() !== false || data.child('bookedBy').val() === auth.uid) && (newData.child('bookedBy').val() === data.child('bookedBy').val() || newData.child('bookedBy').val() === auth.uid || newData.child('bookedBy').val() === null) && (!data.child('reservedFor').exists() || data.child('reservedFor').val() === auth.uid || data.child('reservedUntil').val() < now) && newData.child('adminBlocked').val() === data.child('adminBlocked').val() && newData.child('vipOnly').val() === data.child('vipOnly').val() && newData.child('privateOnly').val() === data.child('privateOnly').val() && newData.child('surcharge').val() === data.child('surcharge').val() && newData.child('fixedPrice').val() === data.child('fixedPrice').val() && newData.child('lunchOverride').val() === data.child('lunchOverride').val() && newData.child('durMin').val() === data.child('durMin').val() && newData.child('personal').val() === data.child('personal').val()))",
              "viewing":   { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
              // Гілки черги: клієнт прибирає лише СВОЇ маркери (пропозиція/резерв), коли забирає або відхиляє слот
              "offeredTo": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
              "reservedFor":   { ".write": "auth != null && data.val() === auth.uid" },
              "reservedUntil": { ".write": "auth != null && root.child('instructors/'+$iid+'/timeslots/'+$date+'/'+$slotId+'/reservedFor').val() === auth.uid" },
              "vipOnly":       { ".validate": "(auth.uid === $iid || (auth.uid === $mid && root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master')) || newData.val() === data.val()" },
              "adminBlocked":  { ".validate": "(auth.uid === $iid || (auth.uid === $mid && root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master')) || newData.val() === data.val()" },
              "privateOnly":   { ".validate": "(auth.uid === $iid || (auth.uid === $mid && root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master')) || newData.val() === data.val()" },
              "surcharge":     { ".validate": "(auth.uid === $iid || (auth.uid === $mid && root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master')) || newData.val() === data.val()" },
              "fixedPrice":    { ".validate": "(auth.uid === $iid || (auth.uid === $mid && root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master')) || newData.val() === data.val()" },
              "lunchOverride": { ".validate": "(auth.uid === $iid || (auth.uid === $mid && root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master')) || newData.val() === data.val()" },
              "durMin":        { ".validate": "(auth.uid === $iid || (auth.uid === $mid && root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master')) || newData.val() === data.val()" }
            }
          }
          }
        },
        "slotBookings_m": {
          "$mid": {
            ".read": "auth != null && auth.uid === $mid && root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master'",
            ".write": "auth != null && auth.uid === $mid && root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master'"
          }
        },
        "timeslots": {
          ".read": true,
          "$date": {
            "$slotId": {
              // Майстер — усе. Клієнт лише свого майстра (є users/{uid}):
              //  • адмінські поля слота (adminBlocked/vipOnly/privateOnly/surcharge/fixedPrice/lunchOverride/durMin/personal) незмінні й не видаляються;
              //  • новий слот — лише як зайнятий (phantom); видалити можна тільки власний phantom (bookedBy);
              //  • ЗАЙНЯТИЙ слот чіпає лише той, хто його зайняв (bookedBy === uid): чужий слот не звільнити і не перезаписати;
              //  • bookedBy можна виставити лише собі; слот, зарезервований для іншого (reservedFor) до reservedUntil, не зайняти.
              // Звільнення слотів при скасуванні і так робить сервер (onBookingChanged, admin SDK).
              ".write": "auth != null && (auth.uid === $iid || (root.child('instructors/'+$iid+'/users/'+auth.uid).exists() && (data.exists() || newData.child('available').val() === false) && (newData.exists() || (data.child('phantom').val() === true && data.child('bookedBy').val() === auth.uid)) && (data.child('available').val() !== false || data.child('bookedBy').val() === auth.uid) && (newData.child('bookedBy').val() === data.child('bookedBy').val() || newData.child('bookedBy').val() === auth.uid || newData.child('bookedBy').val() === null) && (!data.child('reservedFor').exists() || data.child('reservedFor').val() === auth.uid || data.child('reservedUntil').val() < now) && newData.child('adminBlocked').val() === data.child('adminBlocked').val() && newData.child('vipOnly').val() === data.child('vipOnly').val() && newData.child('privateOnly').val() === data.child('privateOnly').val() && newData.child('surcharge').val() === data.child('surcharge').val() && newData.child('fixedPrice').val() === data.child('fixedPrice').val() && newData.child('lunchOverride').val() === data.child('lunchOverride').val() && newData.child('durMin').val() === data.child('durMin').val() && newData.child('personal').val() === data.child('personal').val()))",
              "viewing":   { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
              // Гілки черги: клієнт прибирає лише СВОЇ маркери (пропозиція/резерв), коли забирає або відхиляє слот
              "offeredTo": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
              "reservedFor":   { ".write": "auth != null && data.val() === auth.uid" },
              "reservedUntil": { ".write": "auth != null && root.child('instructors/'+$iid+'/timeslots/'+$date+'/'+$slotId+'/reservedFor').val() === auth.uid" },
              "vipOnly":       { ".validate": "auth.uid === $iid || newData.val() === data.val()" },
              "adminBlocked":  { ".validate": "auth.uid === $iid || newData.val() === data.val()" },
              "privateOnly":   { ".validate": "auth.uid === $iid || newData.val() === data.val()" },
              "surcharge":     { ".validate": "auth.uid === $iid || newData.val() === data.val()" },
              "fixedPrice":    { ".validate": "auth.uid === $iid || newData.val() === data.val()" },
              "lunchOverride": { ".validate": "auth.uid === $iid || newData.val() === data.val()" },
              "durMin":        { ".validate": "auth.uid === $iid || newData.val() === data.val()" }
            }
          }
        },
        "bookings": {
          // Майстер салону (staff, role master) читає записи простору (клієнти спільні); пише лише свої (masterId = його uid) — див. $bookingId
          ".read": "auth != null && ((auth.token.email === 'sash5385@gmail.com' && auth.token.email_verified === true) || root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master')",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && auth.uid === $iid",
            // Клієнт: створює запис (лише status "pending", без службових полів) і далі змінює тільки
            // studentConfirmed/rating/goals/studentNote або скасовує (status "cancelled"). Ціна, борг,
            // мітки, дата/час тощо після створення незмінні, видалити запис чи ці поля теж не можна.
            "$bookingId": {
              ".write": "(auth != null && auth.uid === $uid && root.child('instructors/'+$iid+'/users/'+$uid).exists() && (!data.exists() || (newData.exists() && (!data.child('price').exists() || newData.child('price').exists()) && (!data.child('masterId').exists() || newData.child('masterId').exists()) && (!data.child('debtAmount').exists() || newData.child('debtAmount').exists()) && (!data.child('manualPrice').exists() || newData.child('manualPrice').exists()) && (!data.child('status').exists() || newData.child('status').exists()) && (!data.child('createdBy').exists() || newData.child('createdBy').exists()) && (!data.child('date').exists() || newData.child('date').exists()) && (!data.child('time').exists() || newData.child('time').exists()) && (!data.child('durationHours').exists() || newData.child('durationHours').exists()) && (!data.child('tag').exists() || newData.child('tag').exists()))) && (data.exists() || (newData.child('status').val() === 'pending' && !newData.child('createdBy').exists()))) || (auth != null && root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master' && (newData.exists() ? newData.child('masterId').val() === auth.uid : data.child('masterId').val() === auth.uid) && (!data.exists() || data.child('masterId').val() === auth.uid))",
              "$key": {
                ".validate": "auth.uid === $iid || (root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master' && ($key !== 'masterId' || (newData.isString() && root.child('instructors/'+$iid+'/staff/'+newData.val()).exists()))) || newData.val() === data.val() || (!data.parent().exists() && ($key === 'id' || $key === 'date' || $key === 'time' || $key === 'serviceType' || $key === 'serviceId' || $key === 'serviceName' || $key === 'price' || $key === 'surcharge' || $key === 'discountAmt' || $key === 'durationHours' || $key === 'studentName' || $key === 'phone' || $key === 'studentNote' || $key === 'rescheduledFrom' || $key === 'addons' || $key === 'addonsPrice' || $key === 'bufferMin' || $key === 'packageId' || $key === 'packageName' || $key === 'packageUseId' || $key === 'groupKey' || $key === 'groupCap' || ($key === 'masterId' && newData.isString() && root.child('instructors/'+$iid+'/staff/'+newData.val()).exists()) || $key === 'createdAt' || ($key === 'status' && newData.val() === 'pending'))) || (data.parent().exists() && ($key === 'studentConfirmed' || $key === 'rating' || $key === 'goals' || $key === 'studentNote' || $key === 'cancelledAt' || ($key === 'cancelledBy' && (newData.val() === 'student' || newData.val() === 'reschedule')) || ($key === 'status' && newData.val() === 'cancelled')))"
              }
            }
          }
        },
        // Місця групових записів: { serviceId, capacity, count, seats: { bookingId: uid } }.
        // Клієнт свого майстра може лише створити групу (count 1) або зайняти ОДНЕ місце (count +1, не вище capacity,
        // своє місце = свій uid); зменшувати/видаляти може лише сервер (admin SDK) і майстер.
        "groupSeats": {
          ".read": "auth != null && (auth.uid === $iid || root.child('instructors/'+$iid+'/users/'+auth.uid).exists())",
          "$date": {
            "$time": {
              ".write": "auth != null && (auth.uid === $iid || (root.child('instructors/'+$iid+'/users/'+auth.uid).exists() && ((!data.exists() && newData.child('count').val() === 1 && newData.child('capacity').val() >= 2 && newData.child('capacity').val() <= 30) || (data.exists() && newData.child('count').val() === data.child('count').val() + 1 && newData.child('count').val() <= data.child('capacity').val() && newData.child('capacity').val() === data.child('capacity').val() && newData.child('serviceId').val() === data.child('serviceId').val()))))",
              "seats": { "$bid": { ".validate": "newData.isString() && (auth.uid === $iid || newData.val() === auth.uid || newData.val() === data.val())" } }
            }
          }
        },
        "bookings_by_phone": {
          "$phone": {
            ".read": "auth != null && auth.uid === $iid",
            ".write": "auth != null && auth.uid === $iid"
          }
        },
        "queue": {
          ".read": "auth != null && (auth.uid === $iid || root.child('instructors/'+$iid+'/users/'+auth.uid).exists())",
          "$slotKey": {
            "entries": {
              "$uid": {
                ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
              }
            }
          }
        },
        "userQueue": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        },
        "users": {
          // Майстер салону бачить клієнтів простору і може створити картку гостя (guest_…), чужі картки не змінює
          ".read": "auth != null && root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master'",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            // Клієнт НЕ може змінювати isVip/discount/hoursOffset/lessonBalance/blocked/customPrice/notes/badges…
            // — лише власну анкету й службові гілки нижче. Майстер (auth.uid === $iid) пише все.
            ".write": "auth != null && (auth.uid === $iid || (root.child('instructors/'+$iid+'/staff/'+auth.uid+'/role').val() === 'master' && $uid.beginsWith('guest_') && !data.exists()))",
            "profile":       { ".write": "auth != null && auth.uid === $uid",
                             "photo": { ".validate": "newData.val() === null || (newData.isString() && newData.val().length < 30000 && newData.val().beginsWith('data:image/'))" } },
            "welcomeSent":   { ".write": "auth != null && auth.uid === $uid" },
            "queueOffers":   { ".write": "auth != null && auth.uid === $uid" },
            "fcmTokens":     { ".write": "auth != null && auth.uid === $uid" },
            "internalExam":  { ".write": "auth != null && auth.uid === $uid" },
            // Анкета клієнта: { at, items: [{ id, label, value }] } — до 12 рядків, довжини обмежені
            "intake":        { ".write": "auth != null && auth.uid === $uid",
                               ".validate": "newData.hasChildren(['at','items'])",
                               "at":    { ".validate": "newData.isNumber()" },
                               "items": { "$i": { ".validate": "$i.matches(/^([0-9]|1[01])$/) && newData.hasChildren(['id','label','value'])",
                                                  "id":    { ".validate": "newData.isString() && newData.val().length <= 40" },
                                                  "label": { ".validate": "newData.isString() && newData.val().length <= 80" },
                                                  "value": { ".validate": "newData.isString() && newData.val().length <= 500" },
                                                  "$other": { ".validate": false } } },
                               "$other": { ".validate": false } },
