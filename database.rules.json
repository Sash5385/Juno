{
  "rules": {
    "slugs": {
      ".read": true,
      "$slug": {
        ".write": "auth != null && (!data.exists() || data.child('iid').val() === auth.uid)"
      }
    },
    "instructors": {
      "$iid": {
        ".read": "auth != null && auth.uid === $iid",
        ".write": "auth != null && auth.uid === $iid",
        "timeslots": {
          ".read": true,
          "$date": {
            "$slotId": {
              ".write": "data.child('available').val() === true || (auth != null && auth.uid === $iid) || (auth != null && data.child('offeredTo').child(auth.uid).val() !== null)"
            }
          }
        },
        "admin_data": {
          "services": {
            ".read": true
          }
        },
        "admin_settings": {
          ".read": true
        },
        "bookings": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid) || $uid.matches(/^guest_.+/)",
            ".write": "(auth != null && (auth.uid === $uid || auth.uid === $iid)) || $uid.matches(/^guest_.+/)"
          }
        },
        "users": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        },
        "chats": {
          "general": {
            ".read": "auth != null",
            ".write": "auth != null"
          },
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        },
        "chatMeta": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        },
        "queue": {
          ".read": "auth != null",
          "$slotKey": {
            "entries": {
              "$uid": {
                ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
              }
            }
          }
        },
        "notifications": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        }
      }
    }
  }
}
