{
  "rules": {
    "slugs": {
      ".read": true,
      "$slug": {
        ".write": "auth != null && (data.exists() ? data.child('iid').val() === auth.uid : newData.child('iid').val() === auth.uid)"
      }
    },
    "instructors": {
      "$iid": {
        ".read": "auth != null && auth.uid === $iid",
        ".write": "auth != null && auth.uid === $iid",

        "admin_settings": {
          ".read": true
        },
        "admin_data": {
          "services": { ".read": true }
        },
        "timeslots": {
          ".read": true,
          ".write": "auth != null",
          "$date": {
            "$slotId": {
              "vipOnly":       { ".validate": "auth.uid === $iid || newData.val() === data.val()" },
              "adminBlocked":  { ".validate": "auth.uid === $iid || newData.val() === data.val()" },
              "privateOnly":   { ".validate": "auth.uid === $iid || newData.val() === data.val()" },
              "surcharge":     { ".validate": "auth.uid === $iid || newData.val() === data.val()" },
              "fixedPrice":    { ".validate": "auth.uid === $iid || newData.val() === data.val()" },
              "lunchOverride": { ".validate": "auth.uid === $iid || newData.val() === data.val()" },
              "durMin":        { ".validate": "auth.uid === $iid || newData.val() === data.val()" }
            }
          }
        },
        "bookings": {
          ".read": "auth != null && auth.token.email === 'sash5385@gmail.com'",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        },
        "bookings_by_phone": {
          "$phone": {
            ".read": "auth != null && auth.uid === $iid",
            ".write": "auth != null && auth.uid === $iid"
          }
        },
        "queue": {
          ".read": "auth != null && (auth.uid === $iid || root.child('instructors/'+$iid+'/users/'+auth.uid).exists())",
          "$slotKey": {
            "entries": {
              "$uid": {
                ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
              }
            }
          }
        },
        "userQueue": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        },
        "users": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            "customPrice": { ".validate": "auth.uid === $iid || newData.val() === data.val()" }
          }
        },
        "chats": {
          "general": {
            ".read": "auth != null && (auth.uid === $iid || root.child('instructors/'+$iid+'/users/'+auth.uid).exists())",
            ".write": "auth != null && (auth.uid === $iid || root.child('instructors/'+$iid+'/users/'+auth.uid).exists())"
          },
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        },
        "chatMeta": {
          "general": {
            ".read": "auth != null && (auth.uid === $iid || root.child('instructors/'+$iid+'/users/'+auth.uid).exists())",
            ".write": "auth != null && (auth.uid === $iid || root.child('instructors/'+$iid+'/users/'+auth.uid).exists())"
          },
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        },
        "notifications": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        },
        "settings": {
          ".read": "auth != null && auth.uid === $iid",
          ".write": "auth != null && auth.uid === $iid"
        },
        "push_tasks": { },
        "adminPush": { },
        "recentStudents": {
          ".write": "auth != null && auth.uid === $iid"
        },
        "slotBookings": { },
        "pushTemplates": { },
        "pushLog": { },
        "studentTokens": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "dayNotes": {
          ".read": "auth != null && auth.uid === $iid"
        },
        "reviews": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        },
        "invites": { },
        "fcmTokens": {
          "$deviceId": {
            ".write": "auth != null && auth.uid === $iid"
          }
        },
        "license": {
          ".read": "auth != null && (auth.uid === $iid || auth.token.email === 'sash5385@gmail.com')",
          ".write": "auth != null && (auth.uid === $iid || auth.token.email === 'sash5385@gmail.com')",
          "status": {
            ".validate": "auth.token.email === 'sash5385@gmail.com' || (!data.exists() && newData.val() === 'trial')"
          },
          "trialEndsAt": {
            ".validate": "auth.token.email === 'sash5385@gmail.com' || (!data.exists() && newData.isNumber())"
          },
          "expiresAt": {
            ".validate": "auth.token.email === 'sash5385@gmail.com'"
          },
          "provider": {
            ".validate": "auth.token.email === 'sash5385@gmail.com'"
          },
          "lastPaymentAt": {
            ".validate": "auth.token.email === 'sash5385@gmail.com'"
          }
        }
      }
    },
    "system": {
      ".read": "auth != null && auth.token.email === 'sash5385@gmail.com'",
      ".write": "auth != null && auth.token.email === 'sash5385@gmail.com'"
    },
    "instructor_index": {
      ".read": "auth != null && auth.token.email === 'sash5385@gmail.com'",
      "$iid": {
        ".write": "auth != null && auth.uid === $iid"
      }
    }
  }
}
