{
  "rules": {
    "instructors": {
      "$iid": {
        ".read": "auth != null && auth.uid === $iid",
        ".write": "auth != null && auth.uid === $iid",
        "timeslots": {
          ".read": true
        },
        "admin_data": {
          "services": {
            ".read": "auth != null"
          }
        },
        "admin_settings": {
          ".read": true
        },
        "bookings": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        },
        "users": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        },
        "chats": {
          "general": {
            ".read": "auth != null",
            ".write": "auth != null"
          },
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        },
        "chatMeta": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        },
        "queue": {
          ".read": "auth != null && auth.uid === $iid",
          ".write": "auth != null && auth.uid === $iid"
        },
        "notifications": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === $iid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $iid)"
          }
        }
      }
    }
  }
}
