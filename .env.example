# Firebase-проєкт Juno (Console → Project settings → Your apps → Web app). Без цього працює лише демо (?demo=1).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# URL клієнтського застосунку (для посилання на запис у налаштуваннях)
VITE_CLIENT_URL=https://juno-client.web.app
